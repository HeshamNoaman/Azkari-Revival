<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:gravity="left"
        android:id="@+id/tvHeaderSep"
        android:background="@color/headers_color"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HEADER"
        android:layout_alignParentTop="true"/>
    <ImageView
        android:id="@+id/imgResest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:src="@drawable/icon_reset"
        android:layout_below="@+id/tvHeaderSep"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:gravity="left"
        android:id="@+id/tvTitle"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:text="Azkar Counts"
        android:layout_toLeftOf="@+id/imgResest"
        android:layout_below="@+id/tvHeaderSep"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvCountLabel"
        android:paddingLeft="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Counts"
        android:layout_below="@+id/tvTitle"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvCount"
        android:tag="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14"
        android:layout_toRightOf="@+id/tvCountLabel"
        android:layout_alignTop="@+id/tvCountLabel"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvPeriodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="period"
        android:layout_alignTop="@+id/tvCountLabel"
        android:layout_centerInParent="true"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tvPeriod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="19:33"
        android:layout_toRightOf="@+id/tvPeriodLabel"
        android:layout_alignTop="@+id/tvCountLabel"/>
</RelativeLayout>
