<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TabHost
        android:id="@+id/tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TabWidget
                android:id="@android:id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@android:id/tabcontent"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:id="@+id/rlly1"
                        android:background="@drawable/footer_menu"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerVertical="true">
                        <ImageView
                            android:id="@+id/imgNateShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:src="@drawable/nativeshare"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/imgMenu1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:src="@drawable/menu_icon"
                            android:layout_alignParentRight="true"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"/>
                        <ImageButton
                            android:id="@+id/imgRTf1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_toLeftOf="@+id/imgMenu1"
                            android:layout_toRightOf="@+id/imgNateShare"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <GridView
                        android:gravity="center"
                        android:layout_gravity="fill"
                        android:id="@+id/gvPrayers"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:horizontalSpacing="10dp"
                        android:verticalSpacing="10dp"
                        android:columnWidth="100dp"
                        android:numColumns="2"
                        android:layout_above="@+id/rlly1"/>
                </RelativeLayout>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:id="@+id/rlly"
                        android:background="@drawable/footer_menu"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerVertical="true">
                        <ImageButton
                            android:id="@+id/btnCustom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="4dp"
                            android:layout_alignParentLeft="true"/>
                        <ImageView
                            android:id="@+id/imgMenu2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:src="@drawable/menu_icon"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                        <ImageButton
                            android:id="@+id/imgRTf2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:layout_toLeftOf="@+id/imgMenu2"
                            android:layout_toRightOf="@+id/btnCustom"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                    <GridView
                        android:gravity="center"
                        android:layout_gravity="fill"
                        android:id="@+id/gvTasabeh"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:horizontalSpacing="10dp"
                        android:verticalSpacing="10dp"
                        android:columnWidth="100dp"
                        android:numColumns="2"
                        android:layout_above="@+id/rlly"/>
                </RelativeLayout>
            </FrameLayout>
        </LinearLayout>
    </TabHost>
</LinearLayout>
