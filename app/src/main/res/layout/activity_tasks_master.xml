<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="19sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/txv__Header"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TextView"
        android:layout_alignParentTop="true"/>
    <ListView
        android:id="@+id/ListTasksDays"
        android:background="#00000000"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:listSelector="@android:drawable/list_selector_background"
        android:cacheColorHint="#00000000"
        android:divider="@drawable/islamic_div"
        android:dividerHeight="1px"
        android:layout_below="@+id/txv__Header"/>
    <Button
        android:id="@+id/Info"
        android:background="@android:drawable/ic_dialog_info"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="19dp"
        android:layout_alignBaseline="@+id/txv__Header"
        android:layout_alignBottom="@+id/txv__Header"
        android:layout_alignParentLeft="true"
        style="?android:attr/buttonStyleSmall"/>
</RelativeLayout>
