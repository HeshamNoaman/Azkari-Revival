<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/rllvMain"
    android:background="@drawable/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/par"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">
                <Button
                    android:id="@+id/btnSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="3dp"
                    android:src="@drawable/mute"
                    android:layout_alignParentLeft="true"
                    android:layout_centerHorizontal="true"/>
                <Button
                    android:id="@+id/btnVibtate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginRight="3dp"
                    android:src="@drawable/vibrate_off"
                    android:layout_alignParentRight="true"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/tvPrayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Besm Allah"
                    android:layout_toLeftOf="@+id/btnVibtate"
                    android:layout_toRightOf="@+id/btnSound"
                    android:layout_alignParentTop="true"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:max="100"
            android:progressDrawable="@drawable/progressbarstyle"
            android:layout_below="@+id/header"
            style="?android:attr/progressBarStyleHorizontal"/>
        <Chronometer
            android:id="@+id/ChronTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/header"
            android:layout_centerInParent="true"/>
        <TextView
            android:gravity="center"
            android:id="@+id/txvRepetition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3/3"
            android:layout_below="@+id/ChronTimer"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/lnyCounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/progress"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/lnyText"
        android:background="@drawable/footer_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:tileMode="repeat">
        <RelativeLayout
            android:id="@+id/rlly"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_centerVertical="true">
            <ImageButton
                android:id="@+id/imgbtnControl"
                android:background="@drawable/pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Button"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"/>
            <ImageButton
                android:id="@+id/imgbtnNativeShare"
                android:background="@drawable/native_share_prayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <ImageButton
                android:id="@+id/imgbtnGoToNextPrayer"
                android:background="@drawable/skip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <ImageButton
                android:id="@+id/imgbtnPrayerPrefer"
                android:background="@drawable/fadel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/imgbtnGoToNextPrayer"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/llynavegation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/lnyText">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/imgbtnBack"
                android:background="@drawable/pervious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"/>
            <ToggleButton
                android:textSize="9dp"
                android:id="@+id/tbtAutoPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <ImageButton
                android:id="@+id/imgbtnNext"
                android:background="@drawable/forward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/contentlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llynavegation"
        android:layout_below="@+id/par">
        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:flipInterval="2000">
            <ScrollView
                android:id="@+id/scrollviewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="#ffffff"
                        android:id="@+id/tvPrayerTxt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:layout_marginRight="3dp"
                        android:text="Content"/>
                </LinearLayout>
            </ScrollView>
        </ViewFlipper>
    </RelativeLayout>
</RelativeLayout>
