<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/relativeLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_newTasbeeh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>
        <EditText
            android:id="@+id/EditText_newTasbeeh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_newTasbeeh">
            <requestFocus/>
        </EditText>
        <TextView
            android:textStyle="bold"
            android:textColor="#ff3300"
            android:id="@+id/txvRequiered"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/EditText_newTasbeeh"/>
        <TableLayout
            android:id="@+id/tableLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txvRequiered"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TableRow
        android:gravity="center"
        android:id="@+id/tblrowAddTasbeeha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
