<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18dp"
        android:gravity="center"
        android:id="@+id/txv_aboutUs_header"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About Us"/>
    <TextView
        android:textSize="15dp"
        android:gravity="center"
        android:id="@+id/txv_aboutUs_body"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:scrollbars="vertical|horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TextView"/>
    <TextView
        android:textSize="15dp"
        android:gravity="center"
        android:autoLink="web"
        android:id="@+id/txv_aboutUs_Link"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Link"/>
    <RelativeLayout
        android:id="@+id/relativeLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/relativeLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/relativeLayout2">
            <TextView
                android:textSize="15dp"
                android:gravity="center"
                android:id="@+id/txvRights"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/relativeLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/imgTwitter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/twitter"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/imgFb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/facebook"
                android:layout_toRightOf="@+id/imgTwitter"/>
            <ImageView
                android:id="@+id/imgYouTube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/youtube"
                android:layout_toLeftOf="@+id/imgTwitter"/>
        </RelativeLayout>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:id="@+id/txv_about_developer"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ssssssssssssss"
            android:layout_above="@+id/txv_developer_Link"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15dp"
            android:gravity="center"
            android:autoLink="web"
            android:id="@+id/txv_developer_Link"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Link"
            android:layout_above="@+id/relativeLayout3"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
