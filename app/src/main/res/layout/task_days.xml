<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/Progress"
        android:paddingLeft="15dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_width="160sp"
        android:layout_height="15sp"
        android:progressDrawable="@drawable/ramadan_progress_style"
        android:layout_below="@+id/tvDay"
        android:layout_alignRight="@+id/tvDay"
        android:layout_alignParentLeft="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/img_icon"
        android:paddingLeft="5sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/taskscat2"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:gravity="center_vertical"
        android:id="@+id/tvDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Day1"
        android:layout_toLeftOf="@+id/img_icon"
        android:layout_alignTop="@+id/img_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#8fc202"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tvPrecentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10%"
        android:layout_toLeftOf="@+id/img_icon"
        android:layout_below="@+id/Progress"/>
</RelativeLayout>
