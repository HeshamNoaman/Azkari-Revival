<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rlyWdg"
        android:background="@drawable/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginRight="0dp">
        <TextView
            android:textSize="20dp"
            android:typeface="sans"
            android:textColor="@color/blue_text_header"
            android:gravity="center_horizontal"
            android:id="@+id/txvWTsbeeh"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Azkari "
            android:lines="2"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="30dp"
            android:textColor="@color/blue_text"
            android:gravity="center_horizontal"
            android:id="@+id/txvWCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="0"
            android:layout_below="@+id/txvWTsbeeh"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@android:color/black"
            android:gravity="center_horizontal"
            android:id="@+id/txvWTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="00:00"
            android:layout_below="@+id/txvWCount"/>
        <ImageButton
            android:id="@+id/btnWNext"
            android:background="@drawable/next_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:layout_below="@+id/txvWCount"
            android:layout_alignParentRight="true"/>
        <ImageButton
            android:id="@+id/btnWBack"
            android:background="@drawable/prev_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_below="@+id/txvWCount"
            android:layout_alignParentLeft="true"/>
    </RelativeLayout>
    <Button
        android:layout_gravity="center_horizontal"
        android:id="@+id/btnWAdd"
        android:background="@drawable/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:soundEffectsEnabled="true"/>
</LinearLayout>
